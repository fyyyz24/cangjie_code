digraph DFA {
    rankdir=LR;
    node [shape=circle];
    start [shape=point];
    start -> 0;
    1 [shape=doublecircle];
    2 [shape=doublecircle];
    3 [shape=doublecircle];
    0 -> 1 [label="a"];
    1 -> 2 [label="b"];
    1 -> 3 [label="c"];
    2 -> 2 [label="b"];
    2 -> 3 [label="c"];
    3 -> 2 [label="b"];
    3 -> 3 [label="c"];
}
